{
  "name": "project-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "fix": "eslint . --fix && prettier --write . --log-level warn",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --reporter=dot",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@unhead/vue": "2.1.17",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "28.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-ssg": "28.3.0",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  }
}
